# ─────────────────────────────────────────────────────────────────────────────
# CodeForge — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon cloud PostgreSQL — free at neon.tech) ─────────────────────
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# ── Redis (Upstash cloud Redis — free at upstash.com) ────────────────────────
# Get this from your Upstash console → Details → REST URL → rediss:// connection string
REDIS_URL=rediss://default:password@global-xxx.upstash.io:6379?ssl_cert_reqs=CERT_NONE
CELERY_BROKER_URL=rediss://default:password@global-xxx.upstash.io:6379?ssl_cert_reqs=CERT_NONE
CELERY_RESULT_BACKEND=rediss://default:password@global-xxx.upstash.io:6379?ssl_cert_reqs=CERT_NONE

# ── Gemini API (Google AI Studio — free tier, 500 req/day) ───────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── OpenRouter (optional LLM fallback — free tier at openrouter.ai) ──────────
# Used when Gemini quota is exhausted. Set OPENAI_API_BASE to route through OpenRouter.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENAI_API_KEY=your-openrouter-api-key-here
OPENAI_API_BASE=https://openrouter.ai/api/v1

# ── Anthropic (optional — required only if using Claude models directly) ──────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Application Settings ──────────────────────────────────────────────────────
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

DEBUG=True

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Set False to skip Docker-in-Docker execution (required when no Docker available)
SANDBOX_ENABLED=False

# ── Pipeline Tuning ───────────────────────────────────────────────────────────
# How many models run in parallel for each query (1 = fastest, cheapest)
DEFAULT_ENSEMBLE_SIZE=1

# Whether to run LLM adversarial debate (expensive — uses extra API calls)
USE_DEBATE_ENGINE=False

# Use Ollama (local) for intent parsing — requires Ollama running locally
USE_LOCAL_FOR_INTENT=False

# Use Ollama (local) for self-correction — requires Ollama running locally
USE_LOCAL_FOR_CORRECTION=False

# Maximum times the pipeline will retry after validation failure
MAX_CORRECTION_ATTEMPTS=3

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
