# CodeForge environment template. Keep real secrets in .env only.

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codeforge
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Primary LLM provider (LiteLLM model format: groq/<model slug>)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Optional providers
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=

SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=False
SANDBOX_ENABLED=False
DEFAULT_ENSEMBLE_SIZE=1
USE_DEBATE_ENGINE=False
USE_LOCAL_FOR_INTENT=False
USE_LOCAL_FOR_CORRECTION=False
MAX_CORRECTION_ATTEMPTS=0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
