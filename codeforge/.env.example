# CodeForge environment template. Copy to .env and fill in real values.
# .env is gitignored - never commit real keys.

# ── Infrastructure ────────────────────────────────────────────────────────────
# docker compose overrides these two automatically; set them for a manual run.
DATABASE_URL=postgresql+asyncpg://codeforge:codeforge_password@localhost:5432/codeforge
REDIS_URL=redis://localhost:6379/0            # optional: intent-analysis cache only

# ── LLM providers (each is used in parallel when its key is set) ──────────────
GROQ_API_KEY=                                 # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=                           # https://openrouter.ai/keys  (free ":free" models only)
GEMINI_API_KEY=                               # https://aistudio.google.com/apikey

# ── Pipeline behaviour ────────────────────────────────────────────────────────
DEFAULT_ENSEMBLE_SIZE=3                       # how many providers generate in parallel (1-3)
MAX_CORRECTION_ATTEMPTS=0                     # >0 sends failed validations back to the model to repair
USE_DEBATE_ENGINE=False                       # extra LLM critique stage (costs more calls)
SANDBOX_ENABLED=False                         # run generated code in Docker (needs Docker access)
USE_LOCAL_FOR_INTENT=False                    # True = use local Ollama for intent analysis
USE_LOCAL_FOR_CORRECTION=False

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=False
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
